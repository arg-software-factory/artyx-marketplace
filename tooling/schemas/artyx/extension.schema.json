{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artyx.ai/schemas/agent-plugins/ai.artyx.desktop/3.json",
  "title": "Artyx Desktop plugin extension v3",
  "description": "Explicit conversational and native-asset plugin contract for Artyx Desktop.",
  "type": "object",
  "required": ["schemaVersion", "pluginClass", "interface"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 3 },
    "pluginClass": { "enum": ["conversational", "native-asset"] },
    "interface": { "$ref": "#/$defs/interface" },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "requires": { "$ref": "#/$defs/requires" },
    "userVars": { "$ref": "#/$defs/userVars" },
    "mcp": { "$ref": "#/$defs/mcpOverlay" },
    "nativeRuntimes": { "$ref": "#/$defs/nativeRuntimes" },
    "assetAdapters": { "$ref": "#/$defs/assetAdapters" }
  },
  "allOf": [
    {
      "if": { "properties": { "pluginClass": { "const": "conversational" } } },
      "then": {
        "not": { "anyOf": [{ "required": ["nativeRuntimes"] }, { "required": ["assetAdapters"] }] }
      }
    },
    {
      "if": { "properties": { "pluginClass": { "const": "native-asset" } } },
      "then": { "required": ["nativeRuntimes", "assetAdapters"] }
    }
  ],
  "$defs": {
    "interface": {
      "type": "object",
      "required": ["displayName", "tagline", "category", "docsUrl"],
      "additionalProperties": false,
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "tagline": { "type": "string", "minLength": 1, "maxLength": 100 },
        "category": { "enum": ["Creativity", "Developer Tools"] },
        "docsUrl": { "type": "string", "pattern": "^https://" },
        "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["Interactive", "Read", "Write"] } },
        "brandColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "prompts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "experimental": { "type": "boolean" }
      }
    },
    "compatibility": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "artyx": { "type": "string", "pattern": "^>=\\d+\\.\\d+\\.\\d+$" },
        "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["darwin", "win32", "linux"] } }
      }
    },
    "requires": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "userVars": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$", "not": { "enum": ["PLUGIN_ROOT", "PLUGIN_DATA"] } },
      "additionalProperties": { "$ref": "#/$defs/userVar" }
    },
    "userVar": {
      "type": "object",
      "required": ["type", "label", "description", "required"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["directory", "file", "string", "secret", "boolean"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "description": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "default": { "type": ["string", "boolean"] },
        "mustExist": { "type": "boolean" },
        "extensions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9+_-]*$" } },
        "contains": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\u0000]+$" } },
        "pattern": { "type": "string" }
      }
    },
    "mcpOverlay": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "minLength": 1 },
          "headers": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
          "command": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "env": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
          "cwd": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nativeRuntimes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nativeRuntime" }
    },
    "nativeRuntime": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "delivery", "transport"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "delivery": { "const": "external" },
            "transport": { "$ref": "#/$defs/stdioTransport" }
          }
        },
        {
          "type": "object",
          "required": ["id", "delivery", "artifacts"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "delivery": { "const": "bundled" },
            "artifacts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["platform", "arch", "path", "sha256", "signature", "keyId"],
                "additionalProperties": false,
                "properties": {
                  "platform": { "enum": ["darwin", "win32", "linux"] },
                  "arch": { "enum": ["x64", "arm64"] },
                  "path": { "type": "string", "pattern": "^\\./" },
                  "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "signature": { "type": "string", "minLength": 64 },
                  "keyId": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    },
    "stdioTransport": {
      "type": "object",
      "required": ["type", "command"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "stdio" },
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "cwd": { "type": "string", "minLength": 1 }
      }
    },
    "assetAdapters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assetAdapter" }
    },
    "assetAdapter": {
      "type": "object",
      "required": ["id", "protocol", "runtime", "accepts", "sourceKinds", "methods", "fidelity", "profiles"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "protocol": { "const": "artyx.asset-adapter/2" },
        "runtime": { "$ref": "#/$defs/id" },
        "accepts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/accept" } },
        "sourceKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "methods": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["handshake", "probe", "browseSources", "import", "resolve", "prepareMutation", "compileNative", "export", "validate", "commit", "abandon", "dispose", "cancel"] },
          "allOf": [{ "contains": { "const": "handshake" } }, { "contains": { "const": "probe" } }, { "contains": { "const": "import" } }]
        },
        "fidelity": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["exact-passthrough", "targeted-patch", "semantic-rebuild", "preview-only"] } },
        "profiles": { "type": "array", "items": { "$ref": "#/$defs/profile" } }
      }
    },
    "profile": {
      "type": "object",
      "required": ["id", "semantic", "fidelity", "supportsCreate", "supportsModify"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "semantic": { "type": "string", "minLength": 1 },
        "fidelity": { "enum": ["exact-passthrough", "targeted-patch", "semantic-rebuild", "preview-only"] },
        "supportsCreate": { "type": "boolean" },
        "supportsModify": { "type": "boolean" }
      }
    },
    "accept": {
      "type": "object",
      "required": ["extensions", "kinds"],
      "additionalProperties": false,
      "properties": {
        "extensions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9+_-]*$" } },
        "mediaTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
        "kinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["object3d", "image", "texture-collection", "compound"] } }
      }
    },
    "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
  }
}
